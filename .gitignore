.DS_Store
.idea/
.vscode/

# Claude Code harness. The project-shared files under .claude/ (commands, agents,
# rules) are TRACKED — they are repo process docs, versioned like docs/ is.
# Only genuinely machine-local state stays ignored below.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/agent-memory/

# Secrets and credentials
.env
*.keystore
*.jks
*.p12
*.pem
*.key
local.properties
# Local-only developer scratch files (not part of the SDK)
UnityExample/Assets/Scripts/OctopusTestHarness.cs
UnityExample/Assets/Scripts/OctopusTestHarness.cs.meta

# Unity test-run artifacts
**/TestResults-*.xml

# Scratch file of Scripts/build_legacy_package_nounity.py. The script already removes it
# on failure and renames it into place on success; this is belt and braces, not the fix.
.*.unitypackage.*.tmp

# Local store-publishing credentials, read by Scripts/store/*.sh. None of them is ever
# committed, and none has a CI counterpart — see docs/STORE_PUBLISHING.md.
/keystore.properties
/Scripts/store/play-service-account.json
/Scripts/store/apple-api-key.json

# Output of Scripts/store/publish-android.sh: store-signed App Bundles and their R8 mapping.
# Not just untidy — an unignored release artefact here is one `git add -A` from the tree.
/build/

# Generated before every sample build by OctopusSampleNativePinsProcessor (native build pins)
UnityExample/Assets/Resources/OctopusSampleNativePins.txt
UnityExample/Assets/Resources/OctopusSampleNativePins.txt.meta
